@{
    ViewData["Title"] = "Game of Life";
}

<div class="gol-page">
    <h1 class="mb-3">Game of Life</h1>

    <div class="gol-controls mb-3">
        <div class="btn-group me-3" role="group" aria-label="Playback controls">
            <button id="gol-play" class="btn btn-primary">Play</button>
            <button id="gol-pause" class="btn btn-outline-primary">Pause</button>
            <button id="gol-step" class="btn btn-secondary">Step</button>
            <button id="gol-clear" class="btn btn-outline-danger">Clear</button>
            <button id="gol-random" class="btn btn-outline-success">Randomize</button>
            <button id="gol-age" class="btn btn-outline-dark">Age shading: Off</button>
        </div>
        <div class="d-inline-flex align-items-center me-3">
            <label for="gol-speed" class="form-label mb-0 me-2">Speed</label>
            <input id="gol-speed" type="range" min="1" max="30" value="10" class="form-range" style="width: 180px;" />
            <span id="gol-speed-value" class="ms-2">10 gen/s</span>
        </div>
        <div class="d-inline-flex align-items-center">
            <label for="gol-cell-size" class="form-label mb-0 me-2">Cell size</label>
            <input id="gol-cell-size" type="range" min="4" max="24" value="12" class="form-range" style="width: 180px;" />
            <span id="gol-cell-size-value" class="ms-2">12 px</span>
        </div>
    </div>

    <div class="gol-canvas-wrap">
        <canvas id="gol-canvas" width="900" height="600" aria-label="Game of Life board" tabindex="0"></canvas>
    </div>

    <div class="gol-stats mt-2 d-flex align-items-center">
        <div class="me-3">Generation: <span id="gol-generation">0</span></div>
        <div class="me-3">Live: <span id="gol-live">0</span></div>
        <canvas id="gol-sparkline" width="240" height="40" class="border rounded"></canvas>
    </div>

    <div class="gol-hint text-muted mt-2">
        Click or drag to toggle cells. Hold Shift while dragging to erase. Use arrow keys to step and Space to play/pause.
    </div>
</div>

<link rel="stylesheet" href="~/css/gameOfLife.css" asp-append-version="true" />
<script src="~/js/gameOfLife.js" asp-append-version="true"></script>